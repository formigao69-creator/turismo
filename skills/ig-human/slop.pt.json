  "structures": [
    {
      "id": "nao-e-so",
      "regex": "(?i)\\bn[ãa]o (?:é|e) (?:s[óo]|apenas|somente) [^.!?\\n]{2,60}[,.;]\\s*(?:é|e sim|mas sim)\\b",
      "name": "\"Não é só X, é Y\"",
      "fix": "Diga a única coisa que você quer dizer. Apague a metade da preparação."
    },
    {
      "id": "nao-so-mas",
      "regex": "(?i)\\bn[ãa]o s[óo]\\b[^.!?\\n]{2,80}\\bmas (?:tamb[ée]m|ainda)\\b",
      "name": "\"Não só X, mas também Y\"",
      "fix": "Separe em duas frases ou corte a metade mais fraca."
    },
    {
      "id": "nao-e-sobre",
      "regex": "(?i)\\bn[ãa]o (?:é|se trata) (?:sobre|de) [^.!?\\n]{2,60}[.!,]\\s*(?:é|se trata) (?:sobre|de)\\b",
      "name": "\"Não é sobre X. É sobre Y.\"",
      "fix": "Afirme Y direto. O contraste é muleta."
    },
    {
      "id": "o-resultado",
      "regex": "(?im)^\\s*(?:o resultado|a melhor parte|o detalhe|o segredo|a pegadinha)\\?\\s*$",
      "name": "Linha de pergunta retórica (\"O resultado?\")",
      "fix": "Junte com a frase seguinte e entregue o resultado."
    },
    {
      "id": "aprendi",
      "regex": "(?i)\\b(?:aqui est[áa]|veja) o que (?:eu )?aprendi\\b",
      "name": "\"Aqui está o que aprendi\"",
      "fix": "Diga o que aprendeu, sem o anúncio."
    },
    {
      "id": "triade",
      "regex": "(?i)\\b[\\wÀ-ÿ]+, [\\wÀ-ÿ]+ e [\\wÀ-ÿ]+\\.",
      "name": "Tríade \"X, Y e Z.\"",
      "fix": "Fique com o item mais concreto, ou troque a lista por um exemplo."
    },
    {
      "id": "foguete",
      "regex": "[🚀🔥💡✨🎯🌴🌅]",
      "name": "Emoji de folheto (foguete, fogo, brilho, coqueiro, pôr do sol)",
      "fix": "Tire. A foto já mostra a praia."
    },
    {
      "id": "parede-hashtag",
      "regex": "(?:#\\w+[ \\t]*){6,}",
      "name": "Parede de hashtags (6+)",
      "fix": "O Instagram aceita 5. Fique com lugar, tipo de viagem e público."
    },
    {
      "id": "como-ia",
      "regex": "(?i)\\bcomo (?:uma )?(?:ia|intelig[êe]ncia artificial|modelo de linguagem)\\b",
      "name": "Autorreferência de IA",
      "fix": "Apague."
    },
    {
      "id": "em-resumo",
      "regex": "(?im)^\\s*(?:em resumo|resumindo|em suma|em conclus[ãa]o|concluindo)\\b",
      "name": "Fecho de redação (\"Em resumo\")",
      "fix": "Corte. Legenda não é redação."
    },
    {
      "id": "isca",
      "regex": "(?im)(?:concorda\\?|concordam\\?|o que voc[êe]s? acha(?:m)?\\?|quem mais\\b[^.!?\\n]*\\?|t[ôo] errad[oa]\\?)\\s*$",
      "name": "Isca de engajamento reflexa",
      "fix": "Faça uma pergunta que só quem viajou com você saberia responder."
    },
    {
      "id": "para-de-rolar",
      "regex": "(?im)^\\s*(?:para de rolar|pare de rolar|n[ãa]o role|espera,? n[ãa]o passa)\\b",
      "name": "Abertura \"Para de rolar\"",
      "fix": "Abra com o dado. Quem para é porque o dado prendeu."
    },
    {
      "id": "neste-video",
      "regex": "(?i)\\b(?:n[eo]ss?e (?:v[íi]deo|reels?|post)|no v[íi]deo de hoje|hoje eu vou (?:te )?(?:mostrar|ensinar)|vou (?:te )?(?:mostrar|ensinar) como)\\b",
      "name": "Preâmbulo de vídeo (\"neste vídeo vou te mostrar\")",
      "fix": "Comece no que você ia mostrar."
    },
    {
      "id": "emoji-lista",
      "regex": "(?m)^\\s*[🌀-🫿✅➡⬅✔✨👉]\\s*\\S",
      "name": "Lista com emoji no lugar de marcador",
      "fix": "Use frase corrida ou hífen simples."
    },
    {
      "id": "caixa-alta",
      "regex": "\\b[A-ZÀ-Þ]{3,}\\b(?:\\s+\\b[A-ZÀ-Þ]{3,}\\b){2,}",
      "name": "Três ou mais palavras gritadas seguidas",
      "fix": "Deixe uma palavra em caixa alta, no máximo."
    },
    {
      "id": "isca-seguir",
      "regex": "(?i)\\b(?:siga (?:para|pra) mais|segue (?:para|pra) mais|marque (?:algu[ée]m|quem)|marca (?:algu[ée]m|quem|aquele)|d[êe] dois toques|compartilhe se)\\b",
      "name": "Isca de seguir ou marcar",
      "fix": "Peça uma coisa só, e que faça sentido para o post."
    },
    {
      "id": "adjetivos-empilhados",
      "regex": "(?i)\\b(?:incr[íi]vel|maravilhos[oa]|deslumbrante|espetacular|perfeit[oa]|inesquec[íi]vel|[úu]nic[oa]|paradis[íi]ac[oa]|encantador[a]?)s?\\b[^.!?\\n]{0,25}\\b(?:incr[íi]vel|maravilhos[oa]|deslumbrante|espetacular|perfeit[oa]|inesquec[íi]vel|[úu]nic[oa]|paradis[íi]ac[oa]|encantador[a]?)s?\\b",
      "name": "Adjetivos de folheto empilhados",
      "fix": "Troque os dois adjetivos por um fato: distância, preço, horário, número."
    },
    {
      "id": "voce-ja-imaginou",
      "regex": "(?im)^\\s*(?:voc[êe]|vc) j[áa] (?:imaginou|se perguntou|pensou)\\b",
      "name": "Abertura \"Você já imaginou...\"",
      "fix": "Mostre em vez de pedir para imaginar."
    },
    {
      "id": "descubra",
      "regex": "(?im)^\\s*(?:descubra|conheça|venha descobrir|venha conhecer)\\b",
      "name": "Abertura de folheto (\"Descubra...\")",
      "fix": "Abra com o que a pessoa vai encontrar, com número ou nome."
    }
  ],
  "voice": {
    "informal_regex": "\\b(?:pra|pro|pros|pras|tá|tô|tava|tamo|né|cê|vc|vcs|num|numa|dum|duma|a gente|bora|beleza|demais|tipo)\\b",
    "informal_human": 2.5,
    "informal_label": "marcas de fala (pra, tá, né, a gente)",
    "pronoun_regex": "\\b(?:eu|me|mim|meu|minha|meus|minhas|nós|nosso|nossa|nossos|nossas|a gente|você|vocês|vc|vcs|te|seu|sua|seus|suas|tu|teu|tua)\\b",
    "pronoun_human": 6.0
  }
}
