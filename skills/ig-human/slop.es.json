  "structures": [
    {
      "id": "no-es-solo",
      "regex": "(?i)\\bno es (?:s[óo]lo|solamente|simplemente) [^.!?\\n]{2,60}[,.;]\\s*es\\b",
      "name": "\"No es solo X, es Y\"",
      "fix": "Decí lo único que querés decir. Borrá la mitad del armado."
    },
    {
      "id": "no-solo-sino",
      "regex": "(?i)\\bno s[óo]lo\\b[^.!?\\n]{2,80}\\bsino (?:tambi[ée]n|que)\\b",
      "name": "\"No solo X, sino también Y\"",
      "fix": "Partilo en dos frases o cortá la mitad más débil."
    },
    {
      "id": "no-se-trata",
      "regex": "(?i)\\bno se trata de [^.!?\\n]{2,60}[.!,]\\s*se trata de\\b",
      "name": "\"No se trata de X. Se trata de Y.\"",
      "fix": "Afirmá Y directo."
    },
    {
      "id": "el-resultado",
      "regex": "(?im)^\\s*[¿]?(?:el resultado|lo mejor|el detalle|el secreto|la trampa)\\?\\s*$",
      "name": "Línea de pregunta retórica (\"¿El resultado?\")",
      "fix": "Unila con la frase siguiente y dá el resultado."
    },
    {
      "id": "aprendi",
      "regex": "(?i)\\b(?:ac[aá]|aqu[ií]) (?:est[aá]|va) lo que aprend[ií]\\b",
      "name": "\"Acá está lo que aprendí\"",
      "fix": "Decí lo que aprendiste, sin el anuncio."
    },
    {
      "id": "triada",
      "regex": "(?i)\\b[\\wÀ-ÿ]+, [\\wÀ-ÿ]+ y [\\wÀ-ÿ]+\\.",
      "name": "Tríada \"X, Y y Z.\"",
      "fix": "Quedate con el más concreto, o cambiá la lista por un ejemplo."
    },
    {
      "id": "cohete",
      "regex": "[🚀🔥💡✨🎯🌴🌅]",
      "name": "Emoji de folleto (cohete, fuego, brillo, palmera, atardecer)",
      "fix": "Sacalo. La foto ya muestra la playa."
    },
    {
      "id": "muro-hashtag",
      "regex": "(?:#\\w+[ \\t]*){6,}",
      "name": "Muro de hashtags (6+)",
      "fix": "Instagram acepta 5. Lugar, tipo de viaje y público."
    },
    {
      "id": "como-ia",
      "regex": "(?i)\\bcomo (?:una )?(?:ia|inteligencia artificial|modelo de lenguaje)\\b",
      "name": "Autorreferencia de IA",
      "fix": "Borralo."
    },
    {
      "id": "en-resumen",
      "regex": "(?im)^\\s*(?:en resumen|resumiendo|en conclusi[óo]n|para concluir)\\b",
      "name": "Cierre de redacción (\"En resumen\")",
      "fix": "Cortalo."
    },
    {
      "id": "cebo",
      "regex": "(?im)(?:[¿]?est[aá]s de acuerdo\\?|[¿]?qu[eé] opinan\\?|[¿]?qui[eé]n m[aá]s\\b[^.!?\\n]*\\?|[¿]?me equivoco\\?)\\s*$",
      "name": "Cebo de interacción reflejo",
      "fix": "Hacé una pregunta que solo alguien que viajó sabría responder."
    },
    {
      "id": "deja-de-scrollear",
      "regex": "(?im)^\\s*(?:dej[aá] de scrollear|no (?:scrollees|pases)|esper[aá],? no pases)\\b",
      "name": "Apertura \"Dejá de scrollear\"",
      "fix": "Abrí con el dato."
    },
    {
      "id": "en-este-video",
      "regex": "(?i)\\b(?:en (?:este|el) (?:video|vídeo|reel)(?: de hoy)?|hoy (?:te |les )?voy a (?:mostrar|enseñar)|te voy a mostrar c[oó]mo)\\b",
      "name": "Preámbulo de video",
      "fix": "Empezá por lo que ibas a mostrar."
    },
    {
      "id": "lista-emoji",
      "regex": "(?m)^\\s*[🌀-🫿✅➡⬅✔✨👉]\\s*\\S",
      "name": "Lista con emoji como viñeta",
      "fix": "Usá frase corrida o guion simple."
    },
    {
      "id": "mayusculas",
      "regex": "\\b[A-ZÀ-Þ]{3,}\\b(?:\\s+\\b[A-ZÀ-Þ]{3,}\\b){2,}",
      "name": "Tres o más palabras gritadas seguidas",
      "fix": "Una palabra en mayúsculas, como mucho."
    },
    {
      "id": "cebo-seguir",
      "regex": "(?i)\\b(?:seguinos para m[aá]s|s[ií]guenos para m[aá]s|etiquet[aá] a|dale like si|compart[ií] si)\\b",
      "name": "Cebo de seguir o etiquetar",
      "fix": "Pedí una sola cosa y que tenga sentido para el post."
    },
    {
      "id": "adjetivos-apilados",
      "regex": "(?i)\\b(?:incre[íi]ble|maravillos[oa]|deslumbrante|espectacular|perfect[oa]|inolvidable|[úu]nic[oa]|paradis[íi]ac[oa]|encantador[a]?)s?\\b[^.!?\\n]{0,25}\\b(?:incre[íi]ble|maravillos[oa]|deslumbrante|espectacular|perfect[oa]|inolvidable|[úu]nic[oa]|paradis[íi]ac[oa]|encantador[a]?)s?\\b",
      "name": "Adjetivos de folleto apilados",
      "fix": "Cambiá los dos adjetivos por un dato: distancia, precio, horario."
    },
    {
      "id": "imaginaste",
      "regex": "(?im)^\\s*[¿]?(?:alguna vez )?(?:te imaginaste|imaginate|imagina|te preguntaste)\\b",
      "name": "Apertura \"¿Te imaginaste...?\"",
      "fix": "Mostrá en vez de pedir que imaginen."
    },
    {
      "id": "descubri",
      "regex": "(?im)^\\s*(?:descubr[ií]|descubre|conoc[eé]|conoce|ven[ií] a descubrir|ven a descubrir)\\b",
      "name": "Apertura de folleto (\"Descubrí...\")",
      "fix": "Abrí con lo que van a encontrar, con número o nombre."
    }
  ],
  "voice": {
    "informal_regex": "\\b(?:che|re|dale|posta|bárbaro|genial|tipo|o sea|onda|chévere|porfa|súper|nomás|copado|piola|vos|ustedes|acá)\\b",
    "informal_human": 2.0,
    "informal_label": "marcas de habla (che, dale, re, vos, acá)",
    "pronoun_regex": "\\b(?:yo|me|mi|mis|nosotros|nosotras|nuestro|nuestra|nuestros|nuestras|nos|tú|tu|tus|te|ti|vos|usted|ustedes|contigo)\\b",
    "pronoun_human": 6.0
  }
}
