# Banco de dados PostgreSQL
DATABASE_URL=postgresql://usuario:senha@localhost:5432/turismo_guarapari

# JWT
JWT_SECRET=troque_por_segredo_forte_aqui_min_32_chars
JWT_EXPIRATION=8h

# Servidor
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# E-mail (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notificacoes@guarapari.es.gov.br
SMTP_PASS=senha_do_email
EMAIL_FROM=Sistema Turismo Guarapari <notificacoes@guarapari.es.gov.br>
EMAIL_SEMSET=semset@guarapari.es.gov.br

# Google Sheets (integração com Google Forms)
GOOGLE_SERVICE_ACCOUNT_EMAIL=turismo-api@projeto-guarapari.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GOOGLE_SHEETS_ID=1xXxXxXxXxXxXxXxXxXxXxXxXxXxXxXxXxXxXxXxXx
GOOGLE_SHEETS_RANGE=Respostas ao formulário 1!A:J

# TOTP (duplo fator)
TOTP_ISSUER=TurismoGuarapari

# Parâmetros padrão iniciais
DEFAULT_FIM_TEMPORADA=2026-12-31
